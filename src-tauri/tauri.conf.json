{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jottr",
  "version": "../package.json",
  "identifier": "com.steojo.jottr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jottr",
        "width": 1400,
        "height": 880,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0C0C0E",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      },
      {
        "label": "capture",
        "url": "capture.html",
        "title": "Quick capture",
        "width": 560,
        "height": 88,
        "visible": false,
        "focus": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "theme": "Dark",
        "backgroundColor": "#121215",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
